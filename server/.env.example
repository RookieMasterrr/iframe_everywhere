# Port the API + WebSocket server listens on
PORT=8787

# Public origin of your frontend. Only this origin may call the API.
PUBLIC_ORIGIN=http://localhost:5173

# Kill a session after this many ms with no user input. Sessions are
# expensive (~1 core + ~1GB RAM each) so this is not optional.
SESSION_IDLE_MS=180000
# Hard cap on concurrent sessions before /api/session returns 503.
MAX_SESSIONS=4

# --- SSRF allowlist ---
# Reserved IP ranges to re-permit, comma-separated CIDRs. Empty by default.
#
# You need this if your network resolves public hostnames into a reserved
# range (corporate proxies and VPNs commonly NAT everything into
# 198.18.0.0/15), or if you are deliberately embedding internal dashboards.
#
# Every entry you add is genuine SSRF surface: anything inside these ranges
# becomes reachable by anyone who can submit a URL. Never widen this on a
# public deployment that accepts arbitrary URLs.
# SSRF_ALLOW_CIDRS=198.18.0.0/15
